# 필요한 환경변수 예시 (실제 값은 VM의 .env 에만 저장 — 절대 커밋 금지)
# DB_PASSWORD: speechapp_admin 의 Oracle 비밀번호 (DB 컨테이너 .env 참조)
DB_SERVICE=XEPDB1
DB_HOST=sesac-oracle-db
DB_PORT=1521
DB_USER=speechapp_admin
DB_PASSWORD=
# 웹 로그인 비밀번호 (팀원에게 공유)
ADMIN_PAGE_PASSWORD=
# 세션 서명용 랜덤 문자열: openssl rand -hex 32
SESSION_SECRET=
OCI_NAMESPACE=cn5brhz58dgr
OCI_BUCKET_PROBLEMFILES=bucket-team545-problemfiles
OCI_CONFIG_PATH=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_REGION=ap-seoul-1
